{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audio Manifest",
  "description": "Schema for audio_manifest.json — M5 TTS output consumed by PlayerRuntime",
  "type": "object",
  "required": ["event_file_id", "session_id", "turn", "tts_engine", "voice_id", "items"],
  "properties": {
    "event_file_id": { "type": "string" },
    "session_id": { "type": "string" },
    "turn": { "type": "integer", "minimum": 1 },
    "tts_engine": { "type": "string" },
    "voice_id": { "type": "string" },
    "total_duration_sec": { "type": "number", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "seq", "text", "audio_path", "duration_sec", "sample_rate"],
        "properties": {
          "event_id": { "type": "string", "pattern": "^evt_\\d{4}$" },
          "seq": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "audio_path": { "type": "string", "minLength": 1 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
          "sample_rate": { "type": "integer", "minimum": 8000 }
        }
      }
    }
  }
}
