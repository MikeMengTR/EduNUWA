{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edunuwa/schemas/teaching_events.schema.json",
  "title": "EduNUWA teaching_events.json (v2)",
  "description": "Produced by M4 emitter, consumed by M5 player. Strict schema for all teaching events.",
  "type": "object",
  "required": ["event_file_id", "events"],
  "additionalProperties": true,
  "properties": {
    "event_file_id": { "type": "string" },
    "session_id":    { "type": "string", "pattern": "^SES_[0-9]{14}_[A-Za-z0-9]+$" },
    "turn":          { "type": "integer", "minimum": 1 },
    "question_id":   { "type": "string" },
    "question":      { "type": "string" },
    "topic":         { "type": "string" },
    "skill_id":      { "type": "string" },
    "generated_by":  { "type": "string" },

    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },

  "$defs": {
    "event": {
      "type": "object",
      "required": ["event_id", "type", "seq"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^evt_[0-9]{4}$" },
        "type":     { "enum": ["speak", "board", "formula", "table", "image", "pause", "quiz"] },
        "seq":      { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "speak" } } },
          "then": { "required": ["text"], "properties": { "text": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "type": { "const": "board" } } },
          "then": { "required": ["action", "content"],
            "properties": {
              "action": { "enum": ["write_title", "write_subtitle", "write_bullets", "write_steps", "write_summary", "clear_board", "highlight"] },
              "content": { "type": ["string", "array"] }
            }
          }
        },
        { "if": { "properties": { "type": { "const": "formula" } } },
          "then": { "required": ["latex"],
            "properties": {
              "latex": { "type": "string", "minLength": 1 },
              "display_mode": { "enum": ["block", "inline"] }
            }
          }
        },
        { "if": { "properties": { "type": { "const": "table" } } },
          "then": { "required": ["columns", "rows"],
            "properties": {
              "title":   { "type": "string" },
              "columns": { "type": "array", "items": { "type": "string" } },
              "rows":    { "type": "array", "items": { "type": "array" } }
            }
          }
        },
        { "if": { "properties": { "type": { "const": "image" } } },
          "then": { "required": ["src"],
            "properties": {
              "src":        { "type": "string", "minLength": 1 },
              "image_id":   { "type": "string" },
              "media_type": { "enum": ["static", "gif"] },
              "caption":    { "type": "string" }
            }
          }
        },
        { "if": { "properties": { "type": { "const": "pause" } } },
          "then": { "properties": { "duration_sec": { "type": "number", "minimum": 0 } } } },
        { "if": { "properties": { "type": { "const": "quiz" } } },
          "then": { "required": ["question"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "options":  { "type": "array", "items": { "type": "string" } },
              "blocking": { "type": "boolean" }
            }
          }
        }
      ]
    }
  }
}
