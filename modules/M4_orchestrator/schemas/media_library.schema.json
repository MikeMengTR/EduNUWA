{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edunuwa/schemas/media_library.schema.json",
  "title": "EduNUWA media_library index.json",
  "description": "Teaching image library index at data/media_library/index.json. Maintained by scripts/media_library/, consumed read-only by M6 backend media_library.py. keywords feed the retriever (substring match against the student question), llm_desc is shown to the LLM to decide insertion, caption is shown to students under the image.",
  "type": "object",
  "required": ["version", "images"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "images": {
      "type": "array",
      "items": { "$ref": "#/$defs/image" }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["id", "file", "media_type", "subject", "keywords", "caption", "llm_desc"],
      "properties": {
        "id":         { "type": "string", "pattern": "^IMG_[a-z]+_[0-9]{4}$" },
        "file":       { "type": "string", "description": "Path relative to data/media_library/images/, forward slashes" },
        "media_type": { "enum": ["static", "gif"] },
        "subject":    { "type": "string", "description": "math | physics | chemistry | ..." },
        "topic":      { "type": "string" },
        "keywords":   { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "caption":    { "type": "string", "minLength": 1 },
        "llm_desc":   { "type": "string", "minLength": 1 },
        "width":      { "type": "integer", "minimum": 1 },
        "height":     { "type": "integer", "minimum": 1 },
        "source":     { "enum": ["manual", "teacher_upload", "ai_generated"] },
        "license":    { "type": "string" },
        "status":     { "enum": ["active", "pending_review", "disabled"] },
        "added_at":   { "type": "string" }
      }
    }
  }
}
