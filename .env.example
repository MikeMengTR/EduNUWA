# EduNUWA 环境变量模板 / Environment variable template
# 复制为 .env 并填入你自己的值。绝不要把 .env 提交到 git。
# Copy to .env and fill in your own values. NEVER commit .env to git.

# ---- 必需 / Required ----
# DeepSeek API（AI 教学回复 + 文本精修，OpenAI 兼容协议）
# DeepSeek API (AI teaching responses + text refinement, OpenAI-compatible)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 可选 / Optional ----
# 阿里云 DashScope（Qwen-VL 图片智能标注 / PPT 抽图判定；不配置则退回文本标注）
# Alibaba Cloud DashScope (Qwen-VL image annotation / PPT extraction; falls back to text-only without it)
DASHSCOPE_API_KEY=

# 平台监控台口令（登录页右下角入口；不配置默认 edunuwa-admin，生产环境务必修改）
# Platform admin console key (gear icon on login page; defaults to edunuwa-admin — change it in production)
PLATFORM_KEY=change-me

# 数据目录覆盖（默认使用仓库内 data/）
# Data directory overrides (defaults to in-repo data/)
EDUNUWA_DATA_DIR=
EDUNUWA_OUTPUT_DIR=

# 本机代理排除（如使用 Clash 等代理工具，避免劫持 localhost 请求）
# Proxy exclusion (if using Clash etc., prevents localhost requests being hijacked)
NO_PROXY=localhost,127.0.0.1
